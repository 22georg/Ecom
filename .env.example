# MARQIVO Environment Configuration Example
# Copy this file to .env.local for local development. Never commit real credentials!

# Server & Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Brand Information
NEXT_PUBLIC_SITE_NAME=MARQIVO
NEXT_PUBLIC_SITE_TAGLINE="Modern commerce, intelligently connected."

# Production PostgreSQL Database Connection (Railway target)
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/railway?schema=public"

# Authentication & Security Placeholder (For upcoming auth module)
NEXTAUTH_SECRET="your-random-32-byte-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Storage / Assets (S3 / Cloudinary / Local)
STORAGE_PROVIDER="local"

# API Base URL
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api"
